# ============================================================
# 환경변수 목록 (.env.example) — 이 파일은 git에 커밋됩니다(값은 비워 둠)
# ------------------------------------------------------------
# 실제 값은 절대 여기 넣지 마세요.
#   · 로컬 개발:  .env.local 에 채웁니다 (supabase start 값)
#   · 프로덕션:   Vercel 대시보드 또는 각 서비스 콘솔에서 사람이 직접 관리
#                (.env.production 파일은 만들지 않습니다)
# ============================================================

# 실행 환경: development | production
NODE_ENV=
APP_ENV=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 서버 전용(브라우저에 절대 노출 금지) — 엣지함수/로컬 도구용
SUPABASE_SERVICE_ROLE_KEY=

# --- 파일 업로드(Cloudflare R2 Worker) ---
R2_UPLOAD_URL=

# --- 재정 API(Google Apps Script 웹앱) ---
FINANCE_API_URL=

# --- 나의 도서관(Google Apps Script 웹앱 + 드라이브 폴더) ---
LIBRARY_API_URL=
LIBRARY_FOLDER_ID=

# --- 푸시 알림(OneSignal) ---
ONESIGNAL_APP_ID=

# --- 연말정산 알림 이메일(FormSubmit alias) ---
FORMSUBMIT_EMAIL=

# --- AI 음성/주보(Gemini, 엣지함수 시크릿) ---
GEMINI_API_KEY=
